<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="memestudyPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>iuh.fit.backend.model.User</class>
    <class>iuh.fit.backend.model.Exam</class>
    <class>iuh.fit.backend.model.Round</class>
    <class>iuh.fit.backend.model.Question</class>
    <class>iuh.fit.backend.model.RoundQuestion</class>
    <class>iuh.fit.backend.model.Result</class>
    <class>iuh.fit.backend.model.Answer</class>

    <properties>
      <!-- JDBC Connection properties (default, overridden programmatically in JPAUtil via env vars) -->
      <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/memestudy"/>
      <property name="jakarta.persistence.jdbc.user" value="memeuser"/>
      <property name="jakarta.persistence.jdbc.password" value="memepassword"/>

      <!-- Hibernate properties -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>

