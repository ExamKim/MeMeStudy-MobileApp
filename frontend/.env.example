# ==========================================================
# Cấu hình biến môi trường Frontend (Expo)
# ==========================================================

# URL Backend API (Không dùng localhost khi test trên điện thoại thật qua Expo Go!)
# Hãy thay 192.168.1.x bằng IP mạng LAN của máy tính chạy Backend:
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api

# Chế độ dữ liệu Mock:
# - false: gọi API Backend thật
# - true: dùng dữ liệu mẫu offline (khi Backend chưa chạy)
EXPO_PUBLIC_USE_MOCK=false

